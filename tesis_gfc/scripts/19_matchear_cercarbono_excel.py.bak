"""
19_matchear_cercarbono_excel.py

Asigna municipio a los proyectos de Cercarbono a partir del Excel
"Projects Report" exportado desde registry.cercarbono.com.

El reporte trae UNA FILA POR PROYECTO x VERIFICACION / PERIODO DE
ACREDITACION (234 filas = 126 proyectos en la exportacion de sept. 2026).
Este script:

  1. Filtra Host Country == Colombia.
  2. Colapsa a una fila por Project ID:
       - atributos estables (nombre, metodologia, Duration start...): deben
         ser constantes; si difieren, se detiene.
       - Sector, verificaciones: se concatenan los valores distintos con
         "; " (un sector mixto queda visible y filtro_sectorial lo evalua).
       - Crediting periord start: minimo (inicio del PRIMER periodo; una
         renovacion no es un tratamiento nuevo).
       - Crediting period end: maximo.
  3. Asigna municipio por coincidencia de texto (Project Name + descripcion)
     con lista negra, igual que RENARE.
  4. Escribe el CSV y lo RE-LEE para comprobar que el colapso sobrevivio a
     la escritura (sectores mixtos y fecha minima).

El municipio NO viene como campo estructurado: todo match debe verificarse
(ver correcciones_municipio.csv).

USO
---
    python scripts\\19_matchear_cercarbono_excel.py
    python scripts\\19_matchear_cercarbono_excel.py --excel <ruta> --panel <ruta>
"""

from __future__ import annotations

import argparse
import sys
import unicodedata
from pathlib import Path

import pandas as pd

HEADER_ROW = 17  # fila 18 (1-indexed) del Excel

DIAG_DIR = Path("data/interim/diagnostics")
OUT_FILE = DIAG_DIR / "cercarbono_municipio_matching.csv"

# Misma lista negra validada con RENARE
BLOCKLIST = {
    "COLOMBIA", "CONVENCION", "PARAMO", "FUNDACION", "RESTREPO", "PROVIDENCIA",
    "UNION", "ARGELIA", "BOLIVAR", "SANTANDER", "SUCRE", "GUADALUPE", "BELEN",
    "CONCEPCION", "MERCEDES", "PLATA", "VICTORIA", "ARGENTINA", "FLORIDA",
    "PALMIRA", "INDEPENDENCIA", "LIBERTAD", "ESPERANZA",
}

# Atributos que deben ser identicos en todas las filas de un proyecto
COLS_ESTABLES = [
    "Project Name", "Methodology", "Duration start",
    "Start date first crediting period", "Project URL",
    "Project description (English)", "Project proponent",
]
# Atributos que legitimamente varian: se concatenan los valores distintos
COLS_LISTA = [
    "Sector", "Verification number", "Verification body",
    "Crediting period", "Estimated annual issuance",
]
COL_CRED_INI = "Crediting periord start"   # sic: errata del propio registro
COL_CRED_FIN = "Crediting period end"

# Columnas que se escriben en el CSV de salida (26 y 28 las consumen)
COLS_SALIDA_CERC = [
    "Project ID", "Project Name", "Project Stage", "Project URL",
    "Project proponent", "Project developer", "Is Migrated",
    "Protocol", "Sector", "Methodology", "Mitigation type",
    "Duration start", "Duration end",
    "Start date first crediting period", COL_CRED_INI, COL_CRED_FIN,
    "n_filas_registro",
]


def _normalize(value) -> str:
    if pd.isna(value):
        return ""
    txt = unicodedata.normalize("NFKD", str(value))
    txt = "".join(ch for ch in txt if not unicodedata.combining(ch))
    return txt.upper().strip()


def _unicos(s: pd.Series):
    vals = sorted({str(v).strip() for v in s.dropna() if str(v).strip()})
    return "; ".join(vals) if vals else pd.NA


def construir_tokens(panel_path: Path) -> list[tuple[str, str]]:
    panel = pd.read_csv(panel_path, usecols=["COD_DANE", "NOMBRE_MPI"], dtype={"COD_DANE": str})
    mun = panel.drop_duplicates()
    # zfill: 05142 y no 5142 (antes se perdia el cero inicial)
    return [
        (_normalize(name), str(cod).replace(".0", "").zfill(5))
        for cod, name in mun.itertuples(index=False)
        if len(_normalize(name)) >= 6 and _normalize(name) not in BLOCKLIST
    ]


def cargar_cercarbono(excel_path: Path) -> pd.DataFrame:
    df = pd.read_excel(excel_path, sheet_name="Projects Report", header=HEADER_ROW)
    df = df.dropna(how="all").drop(columns=["Unnamed: 0"], errors="ignore")
    if "Host Country" in df.columns:
        antes = len(df)
        df = df[df["Host Country"] == "Colombia"].copy()
        print(f"Filtrado a Host Country == Colombia: {len(df)}/{antes}")

    df["Project ID"] = df["Project ID"].astype(str).str.strip()

    # 1) Atributos estables
    estables = [c for c in COLS_ESTABLES if c in df.columns]
    conflicto = df.groupby("Project ID")[estables].nunique(dropna=True).gt(1)
    if conflicto.to_numpy().any():
        detalle = conflicto[conflicto.any(axis=1)]
        raise ValueError("Project ID con atributos estables distintos entre filas:\n"
                         + detalle.loc[:, detalle.any()].to_string())

    # 2) Reglas de agregacion
    for c in [COL_CRED_INI, COL_CRED_FIN]:
        if c in df.columns:
            df[c] = pd.to_datetime(df[c], errors="coerce")
    reglas = {c: "first" for c in df.columns if c != "Project ID"}  # primer no nulo
    reglas.update({c: _unicos for c in COLS_LISTA if c in df.columns})
    if COL_CRED_INI in df.columns:
        reglas[COL_CRED_INI] = "min"
    if COL_CRED_FIN in df.columns:
        reglas[COL_CRED_FIN] = "max"

    antes = len(df)
    n_filas = df.groupby("Project ID", sort=False).size().rename("n_filas_registro")
    df = df.groupby("Project ID", sort=False).agg(reglas).join(n_filas).reset_index()
    print(f"Colapsado a una fila por Project ID: {len(df)}/{antes}")

    # Fechas a texto ISO: lo que se escribe es exactamente lo que se ve
    for c in [COL_CRED_INI, COL_CRED_FIN]:
        if c in df.columns:
            df[c] = df[c].dt.strftime("%Y-%m-%d")

    if "Sector" in df.columns:
        mixtos = df[df["Sector"].astype(str).str.contains(";")]
        if len(mixtos):
            print(f"\n{len(mixtos)} proyectos con mas de un Sector:")
            print(mixtos[["Project ID", "Project Name", "Sector"]].to_string(index=False))
    return df


def matchear(df: pd.DataFrame, tokens: list[tuple[str, str]]) -> pd.DataFrame:
    campos_texto = [c for c in ["Project Name", "Project description (English)"] if c in df.columns]
    haystack_norm = df[campos_texto].fillna("").astype(str).agg(" ".join, axis=1).apply(_normalize)

    resultados = []
    for texto in haystack_norm:
        codes, names = set(), set()
        for tok, cod in tokens:
            if tok and tok in texto:
                codes.add(cod)
                names.add(tok)
        resultados.append({
            "n_matches": len(codes),
            "cod_dane": ";".join(sorted(codes)),
            "municipio": ";".join(sorted(names)),
        })

    cols_base = [c for c in COLS_SALIDA_CERC if c in df.columns]
    faltan = sorted(set(COLS_SALIDA_CERC) - set(cols_base))
    if faltan:
        print(f"  Aviso: columnas esperadas que no vienen en el reporte: {faltan}")
    res_df = pd.DataFrame(resultados).reset_index(drop=True)
    return pd.concat([df[cols_base].reset_index(drop=True), res_df], axis=1)


def verificar_salida(ruta: Path, esperado: pd.DataFrame) -> None:
    """Re-lee el CSV y confirma que el colapso sobrevivio a la escritura."""
    leido = pd.read_csv(ruta, dtype=str, encoding="utf-8-sig")
    problemas = []
    if leido["Project ID"].duplicated().any():
        problemas.append("Project ID duplicados en el CSV")
    if "Sector" in esperado.columns:
        n_esp = esperado["Sector"].astype(str).str.contains(";").sum()
        n_csv = leido["Sector"].fillna("").str.contains(";").sum()
        if n_esp != n_csv:
            problemas.append(f"sectores mixtos: {n_esp} en memoria vs {n_csv} en el CSV")
    if COL_CRED_INI in esperado.columns:
        a = esperado.set_index("Project ID")[COL_CRED_INI].fillna("")
        b = leido.set_index("Project ID")[COL_CRED_INI].fillna("").reindex(a.index)
        if (a != b).any():
            problemas.append(f"{(a != b).sum()} fechas de acreditacion distintas tras escribir")
    if problemas:
        raise RuntimeError("El CSV escrito no coincide con el colapso:\n  " + "\n  ".join(problemas))
    print("[OK] CSV verificado: una fila por proyecto, sectores mixtos y fecha minima preservados.")


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser()
    p.add_argument("--excel", type=Path,
                   default=Path("data/raw/auxiliary/cercarbono_projects_report.xlsx"))
    p.add_argument("--panel", type=Path, default=Path("data/final/panel_municipio_year.csv"))
    return p.parse_args()


def main() -> int:
    args = parse_args()
    if Path.cwd().name == "scripts" or not Path("data").exists():
        print("[X] Corre desde tesis_gfc\\, no desde scripts\\.")
        return 1
    for ruta in (args.excel, args.panel):
        if not ruta.exists():
            print(f"ERROR: no encuentro {ruta}")
            return 1

    DIAG_DIR.mkdir(parents=True, exist_ok=True)
    tokens = construir_tokens(args.panel)
    print(f"Tokens de municipio disponibles: {len(tokens)}")

    df = cargar_cercarbono(args.excel)
    out = matchear(df, tokens)

    print(f"\nTotal proyectos Colombia: {len(out)}")
    print(f"  Match unico: {(out['n_matches'] == 1).sum()}")
    print(f"  Ambiguos (>1 municipio mencionado): {(out['n_matches'] > 1).sum()}")
    print(f"  Sin match textual: {(out['n_matches'] == 0).sum()}")

    out.to_csv(OUT_FILE, index=False, encoding="utf-8-sig")
    print(f"\nGuardado: {OUT_FILE}")
    verificar_salida(OUT_FILE, out)
    print("\n*** Todo match (incluso unico) se verifica a mano: correcciones_municipio.csv ***")
    return 0


if __name__ == "__main__":
    sys.exit(main())
