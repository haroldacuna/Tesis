## =============================================================================
## 2. Funcion: correr Callaway-Sant'Anna sobre un subgrupo
## =============================================================================
correr_subgrupo <- function(data_sub, col_gname, etiqueta) {
n_mun <- length(unique(data_sub$COD_DANE))
n_tratados <- data_sub %>% filter(.data[[col_gname]] > 0) %>% distinct(COD_DANE) %>% nrow()
cat(sprintf("\n%-35s municipios=%4d  tratados=%3d  ", etiqueta, n_mun, n_tratados))
if (n_tratados < 3) {
cat("-- omitido (menos de 3 tratados, insuficiente para estimar)\n")
return(NULL)
}
data_modelo <- data_sub %>% rename(.gname = all_of(col_gname))
set.seed(20260824)
att_gt_out <- tryCatch({
att_gt(
yname = "loss_area_ha", tname = "year", idname = "id_num", gname = ".gname",
xformla = ~1, data = data_modelo, control_group = "notyettreated",
est_method = "dr", bstrap = TRUE, cband = TRUE, clustervars = "id_num"
)
}, error = function(e) { cat("ERROR:", conditionMessage(e), "\n"); NULL })
if (is.null(att_gt_out)) return(NULL)
agg <- tryCatch(aggte(att_gt_out, type = "simple", na.rm = TRUE), error = function(e) NULL)
if (is.null(agg)) { cat("-- no se pudo agregar (posiblemente todas las celdas NA)\n"); return(NULL) }
cat(sprintf("ATT=%.2f  SE=%.2f  IC95%%=[%.2f, %.2f]\n",
agg$overall.att, agg$overall.se,
agg$overall.att - 1.96 * agg$overall.se, agg$overall.att + 1.96 * agg$overall.se))
data.frame(
grupo = etiqueta, n_municipios = n_mun, n_tratados = n_tratados,
att = agg$overall.att, se = agg$overall.se,
ic_inf = agg$overall.att - 1.96 * agg$overall.se, ic_sup = agg$overall.att + 1.96 * agg$overall.se
)
}
## =============================================================================
## 3. Heterogeneidad TERRITORIAL -- por region, para cada definicion de tratamiento
## =============================================================================
regiones <- c("Andina", "Caribe", "Pacífica", "Orinoquía", "Amazonía")
for (col_gname in c("first_treat_alta", "first_treat_todas")) {
cat("\n", strrep("=", 70), "\n", sep = "")
cat("HETEROGENEIDAD TERRITORIAL --", col_gname, "\n")
cat(strrep("=", 70), "\n")
panel[[paste0("id_num")]] <- as.numeric(panel$COD_DANE)
resultados <- lapply(regiones, function(r) {
correr_subgrupo(panel %>% filter(region == r), col_gname, r)
})
tabla <- bind_rows(resultados)
if (nrow(tabla) > 0) {
write_csv(tabla, sprintf("output/tablas/heterogeneidad_regional_%s.csv", col_gname))
cat("\nGuardado: output/tablas/heterogeneidad_regional_", col_gname, ".csv\n", sep = "")
}
}
## =============================================================================
## 4. Heterogeneidad "INSTITUCIONAL" (proxy IPM) -- solo si IPM esta disponible
## =============================================================================
if (!all(is.na(panel$grupo_ipm))) {
grupos_ipm <- unique(na.omit(panel$grupo_ipm))
for (col_gname in c("first_treat_alta", "first_treat_todas")) {
cat("\n", strrep("=", 70), "\n", sep = "")
cat("HETEROGENEIDAD POR IPM (proxy socioeconomico, NO institucional estricto) --", col_gname, "\n")
cat(strrep("=", 70), "\n")
resultados <- lapply(grupos_ipm, function(g) {
correr_subgrupo(panel %>% filter(grupo_ipm == g), col_gname, g)
})
tabla <- bind_rows(resultados)
if (nrow(tabla) > 0) {
write_csv(tabla, sprintf("output/tablas/heterogeneidad_ipm_%s.csv", col_gname))
cat("\nGuardado: output/tablas/heterogeneidad_ipm_", col_gname, ".csv\n", sep = "")
}
}
} else {
cat("\n\nSe omite la heterogeneidad por IPM -- no disponible en el año base. ")
cat("Para la heterogeneidad institucional real, integra el Panel de Variables Fiscales\n")
cat("y de Buen Gobierno del CEDE con el mismo patrón usado aquí.\n")
}
cat(
"\n\n*** Nota metodologica: algunas regiones (Orinoquia, Amazonia) tienen pocos",
"municipios en total (59 cada una a nivel nacional) -- si el numero de tratados",
"en esa region es muy chico, el resultado se omite automaticamente (menos de 3",
"tratados) o debe interpretarse con la misma cautela que las cohortes pequenas",
"de la seccion de heterogeneidad temporal. ***\n"
)
## =============================================================================
## 12_heterogeneidad_y_spillover_tasa.R
##
## Repite las tres heterogeneidades (regional, IPM, spillover espacial) usando
## tasa_deforestacion en vez de hectareas absolutas -- para chequear si las
## magnitudes extremas encontradas (especialmente Amazonia, -1,297 ha) son un
## efecto real o sensibilidad a valores extremos, como ya paso con la cohorte
## 2018 en el analisis temporal.
##
## Requiere: 01_preparar_datos_did.R, y para la parte de spillover ademas el
## shapefile de municipios (mismo que usa 10_spillovers_espaciales.R).
##
## USO
## ---
##   Rscript 12_heterogeneidad_y_spillover_tasa.R
## =============================================================================
library(dplyr)
library(haven)
library(sf)
library(spdep)
library(did)
library(readr)
PANEL_ANALISIS <- "C:/Users/USUARIO/Documents/Maestria/Tesis/tesis_gfc/scripts/output/panel_analisis_did.rds"
CEDE_CARACT <- "C:/Users/USUARIO/Documents/Maestria/Tesis/tesis_gfc/data/raw/auxiliary/PANEL_CARACTERISTICAS_GENERALES(2024).dta"
MUNICIPIOS_GPKG <- "C:/Users/USUARIO/Documents/Maestria/Tesis/tesis_gfc/data/interim/municipios_clean.gpkg"
MUNICIPIOS_LAYER <- "municipios_clean"
ANIO_BASE <- 2001L
dir.create("output/tablas", showWarnings = FALSE)
panel <- readRDS(PANEL_ANALISIS)
## =============================================================================
## Funcion generica: correr att_gt() + aggte(simple) sobre un subconjunto,
## para un outcome dado (reutilizable en las 3 heterogeneidades)
## =============================================================================
correr_subgrupo_tasa <- function(data_sub, col_gname, outcome, etiqueta) {
n_mun <- length(unique(data_sub$COD_DANE))
n_tratados <- data_sub %>% filter(.data[[col_gname]] > 0) %>% distinct(COD_DANE) %>% nrow()
n_validos <- data_sub %>% filter(!is.na(.data[[outcome]])) %>% distinct(COD_DANE) %>% nrow()
cat(sprintf("\n%-30s municipios=%4d tratados=%3d validos(outcome)=%4d  ", etiqueta, n_mun, n_tratados, n_validos))
if (n_tratados < 3) { cat("-- omitido (menos de 3 tratados)\n"); return(NULL) }
data_modelo <- data_sub %>% rename(.gname = all_of(col_gname))
set.seed(20260824)
att_gt_out <- tryCatch({
att_gt(
yname = outcome, tname = "year", idname = "id_num", gname = ".gname",
xformla = ~1, data = data_modelo, control_group = "notyettreated",
est_method = "dr", bstrap = TRUE, cband = TRUE, clustervars = "id_num"
)
}, error = function(e) { cat("ERROR:", conditionMessage(e), "\n"); NULL })
if (is.null(att_gt_out)) return(NULL)
agg <- tryCatch(aggte(att_gt_out, type = "simple", na.rm = TRUE), error = function(e) NULL)
if (is.null(agg)) { cat("-- no se pudo agregar\n"); return(NULL) }
cat(sprintf("ATT=%.5f  SE=%.5f  IC95%%=[%.5f, %.5f]\n",
agg$overall.att, agg$overall.se,
agg$overall.att - 1.96 * agg$overall.se, agg$overall.att + 1.96 * agg$overall.se))
data.frame(
grupo = etiqueta, n_municipios = n_mun, n_tratados = n_tratados, n_validos_outcome = n_validos,
att = agg$overall.att, se = agg$overall.se,
ic_inf = agg$overall.att - 1.96 * agg$overall.se, ic_sup = agg$overall.att + 1.96 * agg$overall.se
)
}
## =============================================================================
## 1. Heterogeneidad regional -- tasa de deforestacion
## =============================================================================
region_df <- read_dta(CEDE_CARACT) %>%
filter(ano == ANIO_BASE) %>%
mutate(COD_DANE = formatC(as.integer(codmpio), width = 5, flag = "0")) %>%
mutate(region = case_when(
gandina == 1 ~ "Andina", gcaribe == 1 ~ "Caribe", gpacifica == 1 ~ "Pacífica",
gorinoquia == 1 ~ "Orinoquía", gamazonia == 1 ~ "Amazonía", TRUE ~ NA_character_
)) %>%
select(COD_DANE, region)
panel <- panel %>% left_join(region_df, by = "COD_DANE")
regiones <- c("Andina", "Caribe", "Pacífica", "Orinoquía", "Amazonía")
for (col_gname in c("first_treat_alta", "first_treat_todas")) {
cat("\n", strrep("=", 70), "\n", sep = "")
cat("REGIONAL (tasa_deforestacion) --", col_gname, "\n")
cat(strrep("=", 70), "\n")
tabla <- bind_rows(lapply(regiones, function(r) correr_subgrupo_tasa(panel %>% filter(region == r), col_gname, "tasa_deforestacion", r)))
if (nrow(tabla) > 0) write_csv(tabla, sprintf("output/tablas/heterogeneidad_regional_tasa_%s.csv", col_gname))
}
## =============================================================================
## 2. Heterogeneidad por IPM -- tasa de deforestacion
## =============================================================================
caract_full <- read_dta(CEDE_CARACT)
anios_ipm <- caract_full %>% filter(!is.na(IPM)) %>% distinct(ano) %>% pull(ano) %>% sort()
if (length(anios_ipm) > 0) {
anio_ipm <- min(anios_ipm)
ipm_df <- caract_full %>%
filter(ano == anio_ipm) %>%
mutate(COD_DANE = formatC(as.integer(codmpio), width = 5, flag = "0")) %>%
select(COD_DANE, IPM)
mediana_ipm <- median(ipm_df$IPM, na.rm = TRUE)
ipm_df <- ipm_df %>% mutate(grupo_ipm = ifelse(IPM > mediana_ipm, "IPM alto (más pobreza)", "IPM bajo (menos pobreza)"))
panel <- panel %>% left_join(ipm_df %>% select(COD_DANE, grupo_ipm), by = "COD_DANE")
for (col_gname in c("first_treat_alta", "first_treat_todas")) {
cat("\n", strrep("=", 70), "\n", sep = "")
cat("IPM (tasa_deforestacion) --", col_gname, "\n")
cat(strrep("=", 70), "\n")
grupos <- unique(na.omit(panel$grupo_ipm))
tabla <- bind_rows(lapply(grupos, function(g) correr_subgrupo_tasa(panel %>% filter(grupo_ipm == g), col_gname, "tasa_deforestacion", g)))
if (nrow(tabla) > 0) write_csv(tabla, sprintf("output/tablas/heterogeneidad_ipm_tasa_%s.csv", col_gname))
}
}
## =============================================================================
## 3. Spillover espacial -- tasa de deforestacion
## =============================================================================
cat("\n", strrep("=", 70), "\n", sep = "")
cat("SPILLOVER (tasa_deforestacion)\n")
cat(strrep("=", 70), "\n")
municipios_sf <- st_read(MUNICIPIOS_GPKG, layer = MUNICIPIOS_LAYER, quiet = TRUE)
municipios_sf$COD_DANE <- as.character(municipios_sf$COD_DANE)
if (any(!st_is_valid(municipios_sf))) municipios_sf <- st_make_valid(municipios_sf)
vecinos <- poly2nb(municipios_sf, queen = TRUE)
cod_dane_por_indice <- municipios_sf$COD_DANE
for (col_gname in c("first_treat_alta", "first_treat_todas")) {
primer_trat <- panel %>% distinct(COD_DANE, .data[[col_gname]]) %>% rename(first_treat = all_of(col_gname))
cod_a_first_treat <- setNames(primer_trat$first_treat, primer_trat$COD_DANE)
primer_anio_vecino_tratado <- sapply(seq_along(vecinos), function(i) {
idx_vecinos <- vecinos[[i]]
if (length(idx_vecinos) == 0 || idx_vecinos[1] == 0) return(NA_real_)
ft_vecinos <- cod_a_first_treat[cod_dane_por_indice[idx_vecinos]]
ft_vecinos <- ft_vecinos[!is.na(ft_vecinos) & ft_vecinos > 0]
if (length(ft_vecinos) == 0) return(0)
min(ft_vecinos)
})
tabla_vecinos <- data.frame(COD_DANE = cod_dane_por_indice, first_treat_vecino = primer_anio_vecino_tratado)
panel_spillover <- panel %>%
filter(.data[[col_gname]] == 0) %>%
left_join(tabla_vecinos, by = "COD_DANE") %>%
mutate(first_treat_vecino = ifelse(is.na(first_treat_vecino), 0, first_treat_vecino))
panel_spillover$id_num <- as.numeric(panel_spillover$COD_DANE)
resultado <- correr_subgrupo_tasa(panel_spillover, "first_treat_vecino", "tasa_deforestacion", paste("Spillover -", col_gname))
if (!is.null(resultado)) write_csv(resultado, sprintf("output/tablas/spillover_tasa_%s.csv", col_gname))
}
cat(
"\n\n*** Compara estos resultados contra los de hectareas absolutas (ronda anterior).",
"Si Amazonia/Orinoquia dejan de tener magnitudes extremas con la tasa, confirma que",
"eran valores atipicos, no un efecto real de esa magnitud -- en ese caso, reporta la",
"tasa como el resultado principal de heterogeneidad, con hectareas absolutas como",
"robustez secundaria (documentando la razon). ***\n"
)
